rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test probe
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // User-scoped data: strictly private to each authenticated coach/trainer
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Clients
      match /clients/{clientId} {
        allow read, write: if isOwner(userId) && isValidId(clientId);
      }

      // Workout Programs
      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId) && isValidId(workoutId);
      }

      // Calendar Events
      match /calendar/{eventId} {
        allow read, write: if isOwner(userId) && isValidId(eventId);
      }

      // Completed Workout History (exclusive per client profile)
      match /completedWorkouts/{workoutId} {
        allow read, write: if isOwner(userId) && isValidId(workoutId);
      }

      // Exercise History (weight progressions)
      match /exerciseHistory/{historyId} {
        allow read, write: if isOwner(userId) && isValidId(historyId);
      }

      // Custom Exercise Database
      match /customExercises/{exerciseId} {
        allow read, write: if isOwner(userId) && isValidId(exerciseId);
      }

      // Settings and Active Sessions between tablets
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
