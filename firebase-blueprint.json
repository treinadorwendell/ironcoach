{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Perfil de aluno cadastrado pelo treinador",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "birthDate": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "maxLength": 30 },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "email": { "type": "string", "maxLength": 150 },
        "contractType": { "type": "string", "maxLength": 50 },
        "contractValue": { "type": "number" },
        "phone": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "contractType", "contractValue"]
    },
    "WorkoutProgram": {
      "title": "WorkoutProgram",
      "description": "Ficha e periodização de treino vinculada ao aluno",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "goal": { "type": "string", "maxLength": 200 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "splits": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "name", "goal"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Agendamento de aula ou treino na agenda do tablet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "recurringDays": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 50 },
        "rescheduledDate": { "type": "string", "maxLength": 30 },
        "rescheduledTime": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "clientId", "title", "date", "startTime", "endTime", "status"]
    },
    "CompletedWorkoutRecord": {
      "title": "CompletedWorkoutRecord",
      "description": "Histórico de treino executado vinculado exclusivamente ao perfil de cada cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 150 },
        "programId": { "type": "string", "maxLength": 128 },
        "programName": { "type": "string", "maxLength": 150 },
        "splitId": { "type": "string", "maxLength": 128 },
        "splitName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 20 },
        "completedAt": { "type": "string", "maxLength": 50 },
        "durationSeconds": { "type": "number" },
        "durationFormatted": { "type": "string", "maxLength": 50 },
        "totalVolumeKg": { "type": "number" },
        "exercises": { "type": "array" },
        "trainerNotes": { "type": "string", "maxLength": 3000 }
      },
      "required": ["id", "clientId", "clientName", "programName", "splitName", "date", "completedAt", "durationSeconds", "totalVolumeKg"]
    },
    "ExerciseHistory": {
      "title": "ExerciseHistory",
      "description": "Histórico e progressão de cargas por exercício de cada aluno",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "exerciseName": { "type": "string", "maxLength": 150 },
        "scopedKey": { "type": "string", "maxLength": 250 },
        "entries": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "exerciseName", "entries"]
    },
    "DatabaseExercise": {
      "title": "DatabaseExercise",
      "description": "Exercício customizado adicionado pelo personal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "muscleGroup": { "type": "string", "maxLength": 80 },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "muscleGroup"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Configurações do treinador e sessão ativa sincronizada entre tablets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "activeSession": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId"]
    },
    "ExerciseFinishedSnapshot": {
      "title": "ExerciseFinishedSnapshot",
      "description": "Snapshot de exercício finalizado com séries e PSE para gráficos de evolução",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "exerciseName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "sets": { "type": "array" }
      },
      "required": ["id", "clientId", "exerciseName", "timestamp", "sets"]
    },
    "ClientDietPlan": {
      "title": "ClientDietPlan",
      "description": "Plano alimentar, cálculo metabólico, cardápios por dia/horário e substituições do aluno",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 150 },
        "metabolicConfig": { "type": "object" },
        "schedules": { "type": "array" },
        "activeScheduleId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "name", "schedules"]
    }
  },
  "firestore": {
    "/users/{userId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Coleção de alunos cadastrados pelo personal trainer"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "WorkoutProgram",
      "description": "Programas e fichas de treinos prescritas para os alunos"
    },
    "/users/{userId}/calendar/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Eventos de agenda sincronizados entre os tablets"
    },
    "/users/{userId}/completedWorkouts/{workoutId}": {
      "schema": "CompletedWorkoutRecord",
      "description": "Histórico de treinos concluídos vinculado a cada perfil de aluno"
    },
    "/users/{userId}/exerciseHistory/{historyId}": {
      "schema": "ExerciseHistory",
      "description": "Histórico de progressão de cargas por exercício de cada aluno"
    },
    "/users/{userId}/customExercises/{exerciseId}": {
      "schema": "DatabaseExercise",
      "description": "Exercícios customizados pelo personal"
    },
    "/users/{userId}/exerciseSnapshots/{snapshotId}": {
      "schema": "ExerciseFinishedSnapshot",
      "description": "Snapshots de exercícios finalizados com PSE e carga"
    },
    "/users/{userId}/dietPlans/{planId}": {
      "schema": "ClientDietPlan",
      "description": "Planos nutricionais e cardápios prescritos por aluno"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "Sessão ativa, biblioteca nutricional do profissional e configurações sincronizadas"
    }
  }
}
